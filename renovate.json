{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>miikkak/renovate-config"],
  "regexManagers": [
    {
      "fileMatch": ["^\\.github/workflows/code-review\\.yml$"],
      "matchStrings": ["ANTHROPIC_VERSION: \"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "anthropic",
      "datasourceTemplate": "pypi"
    },
    {
      "fileMatch": ["^\\.github/workflows/dependency-check\\.yml$"],
      "matchStrings": ["PYYAML_VERSION: \"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "PyYAML",
      "datasourceTemplate": "pypi"
    },
    {
      "fileMatch": ["^\\.github/workflows/security-scan\\.yml$"],
      "matchStrings": ["GOVULNCHECK_VERSION: \"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "golang.org/x/vuln",
      "datasourceTemplate": "go"
    }
  ]
}
