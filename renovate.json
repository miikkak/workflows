{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>miikkak/renovate-config"],
  "rebaseWhen": "behind-base-branch",
  "packageRules": [
    {
      "description": "Don't pin ci-cd.yml's verify-* jobs' self-referential miikkak/workflows@main refs to a SHA. Unlike a normal external action, main here is this same repo's own branch — pinning would create a perpetual re-pin PR loop, since every merge (including the pin-update PR's own merge) immediately advances main past whatever was just pinned. @main is deliberately floating; see #156/#157.",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["miikkak/workflows"],
      "enabled": false
    },
    {
      "description": "Super-Linter image bumps change the bundled shfmt, so they stay manual-review (no automerge); release:none because they only touch CI tooling. Consumers get their shfmt pin synced by super-linter.yml on the digest PR.",
      "matchDepNames": ["ghcr.io/super-linter/super-linter"],
      "automerge": false,
      "labels": ["release:none"]
    }
  ],
  "regexManagers": [
    {
      "fileMatch": ["^\\.github/workflows/super-linter\\.yml$"],
      "matchStrings": [
        "SUPERLINTER_IMAGE: (?<depName>ghcr\\.io/super-linter/super-linter):(?<currentValue>v[0-9.]+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "fileMatch": ["^\\.github/workflows/code-review\\.yml$"],
      "matchStrings": ["ANTHROPIC_VERSION: \"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "anthropic",
      "datasourceTemplate": "pypi"
    },
    {
      "fileMatch": ["^\\.github/workflows/dependency-check\\.yml$"],
      "matchStrings": ["PYYAML_VERSION: \"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "PyYAML",
      "datasourceTemplate": "pypi"
    },
    {
      "fileMatch": ["^\\.github/workflows/security-scan\\.yml$"],
      "matchStrings": ["GOVULNCHECK_VERSION: \"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "golang.org/x/vuln",
      "datasourceTemplate": "go"
    },
    {
      "fileMatch": ["^\\.github/workflows/secret-scan\\.yml$"],
      "matchStrings": ["GITLEAKS_VERSION: \"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "gitleaks/gitleaks",
      "datasourceTemplate": "github-releases"
    }
  ]
}
